# Bash / Google Cloud Shell. Copy to config.env and replace the two REQUIRED values.
export PROJECT_ID="REPLACE_WITH_YOUR_PROJECT_ID"
export RUN_REGION="us-central1"
export MODEL_LOCATION="global"
export MODEL_ID="gemini-3.5-flash-lite"
export EMBEDDING_LOCATION="us-central1"
export EMBEDDING_MODEL="gemini-embedding-001"
export EMBEDDING_DIM="768"
export SERVICE_NAME="infs3208-rag-v2"
export RUNTIME_SA="infs3208-rag-runtime@${PROJECT_ID}.iam.gserviceaccount.com"
export BUILD_SA="infs3208-rag-build@${PROJECT_ID}.iam.gserviceaccount.com"
export DEPLOYER_EMAIL="REPLACE_WITH_YOUR_GOOGLE_ACCOUNT_EMAIL"
export INVOKER_EMAIL="$DEPLOYER_EMAIL"
export GOOGLE_CLOUD_PROJECT="$PROJECT_ID"
export TOP_K="3"
export MIN_SCORE="0.25"
